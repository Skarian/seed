# Optional seed setup import only; this file is not the credential store.
# Normal setup prompts and saves all tokens to per-user config/credentials.json.
# Existing saved values take precedence over this file; environment values override.
RUNPOD_API_KEY=
# Required by seed setup for base models and other Hugging Face assets.
HF_TOKEN=
# Optional; skip if not using Civitai assets.
CIVITAI_API_TOKEN=
