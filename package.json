{
  "name": "@skarian/seed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.8.2 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && node scripts/build-operations.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server/main.js",
    "dev": "npm run build && npm start",
    "test": "vitest run",
    "test:browser": "playwright test",
    "prepack": "npm run build",
    "verify": "node scripts/verify.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:network-dependencies": "node scripts/test-network-dependencies.mjs",
    "test:worker-network": "node scripts/test-worker-network.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@fastify/static": "10.1.3",
    "@inquirer/password": "5.2.2",
    "@tus/file-store": "2.1.1",
    "@tus/server": "2.4.5",
    "better-sqlite3": "13.0.3",
    "env-paths": "4.0.0",
    "fastify": "5.12.3",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "2.6.0",
    "sharp": "0.35.4",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "bin": {
    "seed": "dist/server/cli.js"
  },
  "files": [
    "prompting/",
    "dist/server/",
    "dist/shared/",
    "dist/worker/models.json",
    "dist/web/",
    "dist/operations/"
  ]
}
