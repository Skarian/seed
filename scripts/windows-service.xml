<service>
  <id>Seed</id>
  <name>Seed</name>
  <description>Seed image generation and cloud worker coordinator; independent of Windows login.</description>
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <startarguments>"E:\projects\seed\scripts\windows-service.mjs" run</startarguments>
  <stopexecutable>C:\Program Files\nodejs\node.exe</stopexecutable>
  <stoparguments>"E:\projects\seed\scripts\windows-service.mjs" stop</stoparguments>
  <workingdirectory>E:\projects\seed</workingdirectory>
  <env name="STUDIO_DEV_ROOT" value="C:\Services\Seed\profile" />
  <env name="TEMP" value="C:\Services\Seed\profile\temp" />
  <env name="TMP" value="C:\Services\Seed\profile\temp" />
  <env name="PYTHONDONTWRITEBYTECODE" value="1" />
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <serviceaccount><domain>NT SERVICE</domain><user>Seed</user></serviceaccount>
  <logpath>C:\Services\Seed\logs</logpath>
  <log mode="roll-by-size"><sizeThreshold>5120</sizeThreshold><keepFiles>5</keepFiles></log>
  <onfailure action="restart" delay="15 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <resetfailure>1 day</resetfailure>
  <stoptimeout>180 sec</stoptimeout>
  <stopparentprocessfirst>false</stopparentprocessfirst>
</service>
